# Configure locally; never commit real credentials.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Regulatory Agent <agent@your-verified-domain.example>
DATABASE_PATH=data/jobs.sqlite3
TEMP_ROOT=data/tmp
MAX_FILES=10
NAVIGATION_TIMEOUT=60
DOWNLOAD_TIMEOUT=60
JOB_TIMEOUT=1200
MAX_FILE_BYTES=25000000
MAX_TOTAL_BYTES=100000000
MAX_ZIP_BYTES=25000000
MAX_EMAIL_BYTES=35000000
QUEUE_CAPACITY=100
PROVIDER_TIMEOUT=10
SHUTDOWN_TIMEOUT=30
CHROMIUM_CHANNEL=chromium
HEADLESS=true
